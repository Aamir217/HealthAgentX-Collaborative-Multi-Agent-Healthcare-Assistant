# Local LLM (served via Ollama - https://ollama.com)
# Used directly by our own agents, and by RAGWire for per-document metadata
# extraction at ingest time.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local embedding model (HuggingFace/sentence-transformers, downloaded once
# and cached locally). Used by RAGWire.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local cross-encoder reranker (used by RAGWire).
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAGWire vector store. A plain path runs Qdrant embedded on local disk (no
# server needed). Set this to an http(s):// URL (e.g. http://localhost:6333,
# after `docker run -p 6333:6333 qdrant/qdrant`) to use a real Qdrant server
# instead - required if the backend and the ingestion script/CLI need to run
# at the same time, since local Qdrant storage allows only one process.
QDRANT_URL=./qdrant_local
QDRANT_COLLECTION=medical_knowledge

# App database
DATABASE_URL=sqlite:///./health_agent_x.db

# Loop Engineering
MAX_VERIFICATION_LOOPS=3

# Tesseract binary (only needed if not on PATH)
TESSERACT_CMD=
