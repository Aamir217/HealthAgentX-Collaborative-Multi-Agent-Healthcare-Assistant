# Local LLM (served via Ollama - https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local embedding model (sentence-transformers, downloaded once and cached locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local cross-encoder reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAGWire vector store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=medical_knowledge

# App database
DATABASE_URL=sqlite:///./health_agent_x.db

# Loop Engineering
MAX_VERIFICATION_LOOPS=3

# Tesseract binary (only needed if not on PATH)
TESSERACT_CMD=
